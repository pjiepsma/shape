  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "android:apk": "bash scripts/android-apk.sh",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "format": "prettier --write .",
